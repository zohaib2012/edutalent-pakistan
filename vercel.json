{
  "version": 2,
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "cd client && npm install && npm run build",
  "outputDirectory": "client/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/[...path].js"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/[...path].js": {
      "includeFiles": "server/src/**"
    },
    "api/index.js": {
      "includeFiles": "server/src/**"
    }
  }
}
