{
  "version": 2,
  "buildCommand": "cd client && npm install && npm run build && cd ../server && npm install --legacy-peer-deps",
  "outputDirectory": "client/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/[...path].js": {
      "includeFiles": "server/**"
    }
  }
}
